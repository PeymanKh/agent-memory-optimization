# =================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# =================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control - it contains sensitive data
#
# Author: Peyman Kh
# Last Update: 27-09-2025
# =================================================================

# -----------------------------------------------------------------
# ENVIRONMENT SETTINGS
# -----------------------------------------------------------------
# Deployment environment (development, production, testing, staging)
ENVIRONMENT=development

# -----------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------
APP__NAME=agent-memory-optimization
APP__VERSION=1.0.0
APP__DEBUG=true

# -----------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------
LOGGING__LEVEL=INFO
LOGGING__FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------
# MongoDB connection URI (replace with your actual connection string)
DATABASE__URI=mongodb://localhost:27017
DATABASE__NAME=agent_memory_db

# Alternative for MongoDB Atlas:
# DATABASE__URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# -----------------------------------------------------------------
# LLM SERVICE CONFIGURATION
# -----------------------------------------------------------------
# OpenAI Configuration
LLM__MODEL_NAME=gpt-4
LLM__API_KEY=your-openai-api-key-here

# Tavily Search API Configuration
LLM__TAVILY_API_KEY=your-tavily-api-key-here

# -----------------------------------------------------------------
# LANGSMITH TRACING CONFIGURATION
# -----------------------------------------------------------------
# LangSmith API key for tracing (get from https://smith.langchain.com/)
LLM__LANGSMITH_API_KEY=your-langsmith-api-key-here

# LangSmith project name for organizing traces
LLM__LANGSMITH_PROJECT=agent-memory-optimization

# Enable LangChain v2 tracing (recommended)
LLM__LANGCHAIN_TRACING_V2=true

# =================================================================
# NOTES AND INSTRUCTIONS
# =================================================================
#
# 1. SECURITY: Never commit the actual .env file to version control
# 2. NESTED VARIABLES: Use double underscore (__) for nested configuration
# 3. REQUIRED VARIABLES: All variables above are required for the application to run
# 4. BOOLEAN VALUES: Use true/false (lowercase) for boolean settings
#
# HOW TO GET API KEYS:
# - OpenAI: https://platform.openai.com/api-keys
# - Tavily: https://app.tavily.com/
#
# MONGODB SETUP:
# - Local: Install MongoDB locally or use Docker
# - Cloud: Create a free cluster at https://cloud.mongodb.com/
#
# =================================================================
